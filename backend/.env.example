# Copy this file to .env and fill in real values. Never commit the real .env file.

DATABASE_URL=postgresql+psycopg2://civicflow:civicflow@localhost:5432/civicflow
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

UPLOAD_DIR=uploads
REPORTS_DIR=reports

# tesseract | demo  -- automatically falls back to demo mode if tesseract isn't installed
OCR_ENGINE=tesseract

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_SIZE_MB=10
